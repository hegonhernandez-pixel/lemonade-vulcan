# Acceso opcional a un proyecto Supabase que elijas para esta aplicación.
COMPRESSO_AUTH_ENABLED=0
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
COMPRESSO_AUTH_EMAILS=
# Modo de prueba con imágenes y voz de demostración.
COMPRESSO_LOCAL_DEMO=0

# Archivos locales y GPU de Linux. Consulta los nombres con sd-cli --list-devices.
COMPRESSO_SD_CLI=sd-cli
COMPRESSO_VULKAN_DEVICE=vulkan0
COMPRESSO_SD_TURBO_GGUF=
COMPRESSO_SD_TURBO=
COMPRESSO_SDXL_TURBO=
COMPRESSO_SDXL_BASE=
COMPRESSO_IP_ADAPTER=
COMPRESSO_CLIP_VISION=

# Proveedores de guion, opcionales. Define COMPRESSO_CREDENTIAL_KEY si prefieres
# ingresar y guardar las claves de API cifradas desde Ajustes.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COMPRESSO_CREDENTIAL_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
