# Adaptado del ejemplo SDXL de Stable Diffusion.cpp, con IP-Adapter Plus.
fn main() {
    unet = load_unet(weights, backend = device)
    text = load_text_encoder(weights, backend = device)
    vae = load_vae(weights, backend = device, conv_scale = 0.03125)
    vision = load_vision_encoder(vision_weights, backend = device)
    adapter = ip_adapter::load(adapter_weights, family = "sdxl", backend = device)
    reference = image::load(input_path)
    embedding = encode_vision(vision, reference, pooled = false, clip_skip = 2)
    empty = encode_vision(vision, reference, pooled = false, clip_skip = 2, zero_input = true)
    positive_image = ip_adapter::project(adapter, embedding)
    negative_image = ip_adapter::project(adapter, empty)
    positive = ip_adapter::apply(encode_prompt(text, prompt, width = width, height = height), adapter, positive_image, strength = strength)
    negative = ip_adapter::apply(encode_prompt(text, negative_prompt, width = width, height = height), adapter, negative_image, strength = strength)
    pos = predictor(unet, positive, prediction = "eps")
    neg = predictor(unet, negative, prediction = "eps")
    base = tensor::zeros(latent_shape(vae, width = width, height = height))
    guided = cfg(pos, neg, scale = cfg_scale)
    sigmas = make_sigmas(guided, latent = base, scheduler = "karras", steps = steps)
    rng = make_rng("cpu", seed = seed)
    start = add_noise(guided, base, tensor::randn_like(base, rng = rng), sigma = sigmas[0])
    latent = sample(start, sigmas, predict = guided, method = "dpm++2m", rng = rng)
    image = vae_decode(vae, unet_to_vae_latents(vae, latent), tiling = tiling())
    image::save(output_path, image)
}
